# 复制为 .env 后按需修改（docker compose 会自动读取）
# cp .env.example .env

# Grafana 监听宿主机端口（与 docker-compose.yml 中 GRAFANA_PORT 对应）
GRAFANA_PORT=3000

# Grafana 对外根 URL（反代或内网域名时修改）
GF_SERVER_ROOT_URL=http://localhost:3000

# Grafana 管理员密码（首次登录 admin / 该密码）
GF_SECURITY_ADMIN_PASSWORD=admin

# 可选：与 ingest 写入的库名一致（provisioning 里 defaultDatabase 需与此一致）
CLICKHOUSE_DATABASE=experience

# 可选：与 compose 内 ClickHouse 暴露端口一致（仅 full-stack profile）
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000